# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Proyecto2_visual
DB_DIALECT=postgres
DB_USER=postgres
DB_PASSWORD=Peroqueconio12

# Configuración del pool de conexiones
# POOL_SIZE: tamaño inicial del pool (número de conexiones que se crean al
#           inicio). Si no se especifica, el valor por defecto es 1.
# POOL_MIN_SIZE: tamaño mínimo al que puede encogerse el pool cuando hay muchas
#                conexiones libres. Si no se da, se usa el mismo valor que
#                POOL_SIZE.
# POOL_MAX_SIZE: tamaño máximo al que puede crecer el pool cuando hay mucha
#                demanda. Si no se da, se usa el mismo valor que POOL_SIZE.
# POOL_DOWN_THRESHOLD: porcentaje de conexiones libres requerido para cerrar
#                      una de ellas (ej. 70 significa 70% libres antes de
#                      reducir). Valor entre 0 y 100; 0 deshabilita la reducción.
# POOL_TIMEOUT se conserva por compatibilidad, no es usado actualmente.
POOL_SIZE=20
POOL_MIN_SIZE=10
POOL_MAX_SIZE=3000
POOL_DOWN_THRESHOLD=70
POOL_TIMEOUT=3000
